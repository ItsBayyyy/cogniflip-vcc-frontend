# Server-only backend URL used by the Next.js BFF.
COGNIFLIP_API_BASE_URL=http://localhost:8000/api/v1
SITE_URL=http://localhost:3000

# Stage demo: show a "Demo lines" panel on the session page that sends
# prepared or typed lines without the mic (replies are still spoken).
# Inlined at build time — rebuild/redeploy after changing. Lines split by "|".
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_LINES=
